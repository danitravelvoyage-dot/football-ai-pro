# ---- PUBLIC values (safe to expose in the browser) ----
# Supabase: Project Settings -> API -> Project URL and the "anon public" key
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# WhatsApp number in international format, digits only (e.g. 213555000000 for Algeria)
NEXT_PUBLIC_WHATSAPP_NUMBER=213000000000

# Public site address, used for sitemap and password-reset links (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# NEVER put the Supabase "service_role" key in this project. This app does not need it.

# ---- AI scheduler (server-only; leave empty until the scheduler is set up) ----
# Shared secret for the external trigger that calls POST /api/ai/scheduler. At least 32 random characters.
AI_SCHEDULER_SECRET=
# Credentials of the scheduler's operator account (a Supabase user listed in ai_operators).
AI_WORKER_EMAIL=
AI_WORKER_PASSWORD=

# ---- Local AI (optional, OFF by default) -------------------------------------------------
# Off until the owner enables it. No key is needed for a local model. Nothing here is a secret.
# AI_LOCAL_ENABLED=false
# AI_LOCAL_BASE_URL=http://localhost:11434/v1
# AI_LOCAL_MODEL=qwen2.5:0.5b
# AI_LOCAL_MAX_RETRIES=1
# AI_LOCAL_DAILY_LIMIT=500
# Mock output is placeholder text. It is ignored whenever a real provider is enabled.
# AI_MOCK_ENABLED=false

# ---- Customer emails (server-only; OFF by default) -----------------------------------------------
# Transactional emails to customers (request received, status changes, documents, payments). Any SMTP server works,
# including a free mailbox with SMTP access. See docs/EMAIL_NOTIFICATIONS.md. Never commit real values.
# Delivery stays OFF unless this is exactly "true". Leave it off on development and staging copies.
EMAIL_DELIVERY_ENABLED=false
SMTP_HOST=
# 587 = STARTTLS (required by the app), 465 = implicit TLS
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Sender shown to customers, e.g. GLOBALTRAVELASSI <no-reply@your-domain>
EMAIL_FROM=
# Optional: where replies go, e.g. a monitored inbox
EMAIL_REPLY_TO=
