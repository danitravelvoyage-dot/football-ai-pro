# ---- PUBLIC values (safe to expose in the browser) ----
# Supabase: Project Settings -> API -> Project URL and the "anon public" key
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# WhatsApp number in international format, digits only (e.g. 213555000000 for Algeria)
NEXT_PUBLIC_WHATSAPP_NUMBER=213000000000

# Public site address, used for sitemap and password-reset links (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# NEVER put the Supabase "service_role" key in this project. This app does not need it.
