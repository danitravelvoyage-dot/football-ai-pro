# ───────────────────────────────────────────────────────────────────────────────
# FOOTBALL AI PRO — environment variables (server-side only; never exposed to the browser)
# Copy to .env.local for local development. All providers below have FREE tiers.
# With no keys at all, the app runs in clearly-labelled DEMO mode (simulated data).
# ───────────────────────────────────────────────────────────────────────────────

# Data mode: auto (default: LIVE if FOOTBALL_DATA_API_KEY is set, otherwise DEMO) | live | demo
DATA_MODE=auto

# football-data.org — fixtures, results, standings, head-to-head, squads
# Free key: https://www.football-data.org/client/register  (free tier ≈ 10 requests/minute)
FOOTBALL_DATA_API_KEY=
FOOTBALL_DATA_RATE_PER_MIN=10

# The Odds API — bookmaker odds (1X2 + totals). Free key: https://the-odds-api.com
# Free tier has a monthly credit quota; each league request costs (markets × regions) credits.
ODDS_API_KEY=
ODDS_API_REGIONS=eu

# API-Football (api-sports.io) — injuries, suspensions, official lineups.
# Free key: https://dashboard.api-football.com/register  (small daily quota; season access may be limited)
API_FOOTBALL_KEY=
API_FOOTBALL_RATE_PER_MIN=10

# PostgreSQL for the prediction tracker (e.g. Supabase free tier connection string).
# Without it, predictions are stored in .data/predictions.json (development only).
# Example: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=
